{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@app/core/*": [
                "../app_core/src/*"
            ],
            "@components/*": [
                "../app_core/src/components/*"
            ],
            "@shadcn/ui/*": [
                "../app_core/src/components/ui/*"
            ],
            "@serverSchema/*": [
                "../../schema/server/*"
            ],
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.vue",
        "src/**/*.d.ts",
        "../app_core/src/**/*.d.ts",
        "../app_core/src/**/*.ts",
        "vite.config.ts",
        "auto-imports.d.ts",
        "components.d.ts"
    ]
}