# Cargo
/target/
Cargo.lock
**/*.rs.bk

# Tauri 生成文件
/gen/*
!/gen/android/
/gen/android/*
!/gen/android/app/
/gen/android/app/*
!/gen/android/app/build.gradle.kts
!/gen/android/app/src
!/gen/android/app/src/main
!/gen/android/app/src/main/AndroidManifest.xml
!/gen/android/app/src/main/res
!/gen/android/app/src/main/res/xml
!/gen/android/app/src/main/res/xml/file_paths.xml
/src-tauri/gen/

# Android 构建期产物：Tauri CLI / Gradle 会在 android init 或 build 时重建，不入库
/gen/android/app/src/main/assets/
/gen/android/app/src/main/java/**/generated/
/gen/android/app/src/main/jniLibs/

