{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://muxidream.cn/*"
        },
        {
          "url": "https://*.muxidream.cn/*"
        },
        {
          "url": "https://gamecms-res.sl916.com/*"
        },
        {
          "url": "http://gamecms-res.sl916.com/*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://10.0.2.2:*"
        }
      ]
    },
    "os:default",
    "opener:default"
  ]
}